<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SERVICIO COMPLETO"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#001D75"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/imgFullService"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/serviciocompleto"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:background="#EEEEEE" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nuestro servicio completo ofrece una limpieza exhaustiva tanto del interior como del exterior del vehículo. Incluye lavado exterior, limpieza de llantas, aspirado de interiores, limpieza de alfombrillas, cristales y perfumado del habitáculo."
                android:textSize="16sp"
                android:textColor="#444444"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beneficios:\n• Coche limpio por dentro y por fuera\n• Mayor comodidad y tiempo ahorrado\n• Ideal para una limpieza periódica completa\n• Mejora la higiene y presentación del vehículo"
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Precio: 40€"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#001D75"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏱ Duración: 30-40 minutos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#001D75"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="unlabeled" />
</LinearLayout>
